{
  "name": "apcosys-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/build.ts",
    "build:root": "tsx scripts/build.ts --base=/",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts docs README.md *.json *.ts *.html",
    "test": "playwright test",
    "test:smoke": "playwright test --config=playwright.release.config.ts",
    "check": "npm run legal:check && npm run verify:assets && npm run verify:source && npm run verify:visuals && npm run verify:styles && npm run verify:architecture && npm run verify:localization && npm run format:check && npm run lint && npm run typecheck",
    "format:check": "prettier --check src tests scripts docs README.md *.json *.ts *.html",
    "test:production": "playwright test --config=playwright.release.config.ts",
    "verify:visuals": "tsx scripts/verify-visuals.ts",
    "verify:assets": "tsx scripts/verify-assets.ts",
    "verify:bundle": "tsx scripts/verify-bundle.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "legal:compile": "tsx scripts/compile-legal.ts",
    "legal:check": "tsx scripts/compile-legal.ts --check",
    "test:release": "playwright test --config=playwright.release.config.ts",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.ts",
    "test:relocation": "playwright test --config=playwright.relocation.config.ts",
    "handoff:package": "tsx scripts/export-handoff.ts",
    "verify:styles": "tsx scripts/verify-styles.ts",
    "verify:architecture": "tsx --test scripts/tests/*.test.ts && tsx scripts/verify-architecture.ts",
    "measure:performance": "tsx scripts/measure-performance.ts",
    "verify:source": "tsx scripts/verify-source-tree.ts",
    "verify:localization": "tsx scripts/verify-localization.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typograf": "7.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "marked": "17.0.1",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
