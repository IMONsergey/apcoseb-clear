# Public, build-time settings: NEVER store secrets in VITE_* variables.
VITE_APCO_PRODUCT_URL=https://apcosys.net
VITE_APCO_SUPPORT_EMAIL=info@apcosys.net

# Optional: sign-in route on the product origin. Defaults to /login.
# VITE_APCO_SIGN_IN_URL=https://apcosys.net/login

# Optional: final marketing-site HTTPS origin for static canonical/OG metadata.
# This is NOT the product URL, and it must not include the hosting subdirectory.
# APCO_PUBLIC_SITE_ORIGIN=https://www.example.com

# Preview copies default to noindex. Set true only for the final public site.
# true requires APCO_PUBLIC_SITE_ORIGIN to be a valid HTTPS origin.
APCO_SITE_INDEXABLE=false
